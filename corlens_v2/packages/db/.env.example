# Used ONLY for host-side Prisma commands run outside Docker, e.g.
#   pnpm --filter @corlens/db prisma:push      # sync schema
#   pnpm --filter @corlens/db prisma:studio    # browse data
#
# For the Docker flow you do NOT need this file — `docker compose up`
# pushes the schema automatically via the `migrate` service.
#
#   cp .env.example .env
#
# Host port is 5435 (mapped from the container's 5432 in docker-compose.yml).
DATABASE_URL=postgresql://corlens:corlens_dev@localhost:5435/corlens
