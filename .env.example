# ═══════════════════════════════════════════════════════════════════
#  CORLens — central secrets file (single source of truth)
#
#  Run the whole corlens_v2 stack from the REPO ROOT:
#
#      cp .env.example .env      # then fill what you need below
#      docker compose up         # builds + starts everything
#
#  The stack BOOTS AND RUNS with NO .env at all — every value below has a
#  working dev default baked into corlens_v2/docker-compose.yml, and the DB
#  schema is created automatically on first boot (the `migrate` service).
#  Set a variable here only to override its default.
#
#  The ONE thing worth setting for real functionality:
#      OPENAI_API_KEY — without it, chat + embeddings won't work.
# ═══════════════════════════════════════════════════════════════════

# ── AI (ai-service) ────────────────────────────────────────────────
# Required for the AI features (chat, embeddings). https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: enables web search in the agent. Leave empty to disable.
TAVILY_API_KEY=

# ── Auth / internal secrets ────────────────────────────────────────
# Fine to leave unset for local dev. CHANGE BOTH for any public deploy.
JWT_SECRET=dev-secret-change-me-must-be-at-least-32-chars
INTERNAL_HMAC_SECRET=dev-internal-hmac-secret-do-not-use-in-prod-aaaaaaa

# ── XRPL payments (identity) ───────────────────────────────────────
# Only needed to process real XRPL payments.
XRPL_PAYMENT_WALLET_ADDRESS=rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh
XRPL_DEMO_WALLET_SECRET=

# ── XRPL RPC (market-data) ─────────────────────────────────────────
# Public clusters by default; override to point at your own node.
XRPL_PRIMARY_RPC=wss://xrplcluster.com
XRPL_PATHFIND_RPC=wss://xrplcluster.com
